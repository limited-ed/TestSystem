{
  "Data": {
    "Provider": "SQLite",
    "SQLite": "Data Source=/app/data.sqlite",
    "PostgreSQL": "User ID=postgres;Password=1;Host=postgres;Port=5432;Database=kortex;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": [
    {
      "Name": "Default",
      "Origins": ["Any"],
      "Methods": ["Any"],
      "Headers": ["Any"]
    }
  ],
  "JWTKey": {
    "ValidAudience": "https://localhost:5270",
    "ValidIssuer": "https://localhost:5270",
    "TokenExpiryTimeInHour": "3",
    "PublicKey": "/app/keys/public.pem",
    "PrivateKey": "/app/keys/private.pem"
  },
  "AllowedHosts": "*",
  "SpaServices": {
    "NodeServer": {
      "StartNodeServer": false,
      "Path": "..\\..\\Client\\dist\\Client\\server\\server.mjs"
    },
    "ReverseProxy": {
      "UseReverseProxy": true,
      "Options": {
        "Include": {
          "":"http://localhost:4000"
        },
        "Exclude" : [
          "/api"
        ]
      }
    }
  }
}